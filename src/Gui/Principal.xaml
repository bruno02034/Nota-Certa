<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotaCerta - Duplicidade NFC-e" Width="1440" Height="880" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5" FontFamily="Segoe UI" FontSize="13"
        Foreground="#2B2F36" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Laranja" Color="#FF5A1F"/>
    <SolidColorBrush x:Key="LaranjaEscuro" Color="#E84A12"/>
    <SolidColorBrush x:Key="LaranjaClaro" Color="#FFF1EA"/>
    <SolidColorBrush x:Key="Azul" Color="#1E7BFF"/>
    <SolidColorBrush x:Key="Verde" Color="#16A34A"/>
    <SolidColorBrush x:Key="Vermelho" Color="#DC2626"/>
    <SolidColorBrush x:Key="TextoSec" Color="#6B7280"/>
    <SolidColorBrush x:Key="Borda" Color="#E5E7EB"/>
    <LinearGradientBrush x:Key="GradTopo" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF5A1F" Offset="0"/>
      <GradientStop Color="#FF9A62" Offset="0.45"/>
      <GradientStop Color="#1E7BFF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="CardFundo" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#0F172A"/></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardLinha" TargetType="Border">
      <Setter Property="Height" Value="3"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
      <Setter Property="Background" Value="{StaticResource GradTopo}"/>
    </Style>
    <Style x:Key="TituloCard" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Tag" Value="titulo"/>
    </Style>
    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextoSec}"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>
    <Style x:Key="NumeroGrande" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="CampoChave" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="Icone" TargetType="Path">
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <Style x:Key="BtnPrimario" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Laranja}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource LaranjaEscuro}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnSecundario" TargetType="Button">
      <Setter Property="Foreground" Value="#2B2F36"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F8FAFC"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FFB899"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnAzul" TargetType="Button" BasedOn="{StaticResource BtnSecundario}">
      <Setter Property="Foreground" Value="{StaticResource Azul}"/>
      <Setter Property="BorderBrush" Value="#B9D4FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BtnLink" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Azul}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pilula" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Pilulas"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="17" Padding="15,7" Background="Transparent" Margin="2,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F3F4F6"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Laranja}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Menu" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Menu"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="44">
              <Border x:Name="b" CornerRadius="8" Background="Transparent"/>
              <Border x:Name="barra" Width="4" HorizontalAlignment="Left" CornerRadius="2" Margin="0,8" Background="{StaticResource Laranja}" Visibility="Collapsed"/>
              <ContentPresenter Margin="16,0,8,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F7F7F8"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource LaranjaClaro}"/>
                <Setter TargetName="barra" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Laranja}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="#EDEFF2"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF5A1F" Offset="0"/>
                    <GradientStop Color="#FF8A4C" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F3"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="40"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="White"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource TextoSec}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,10"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="8,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource LaranjaClaro}"/>
          <Setter Property="Foreground" Value="#2B2F36"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TextoDireita" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="TextoForte" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="TextoCortado" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <DataTemplate x:Key="Etiqueta">
      <Border x:Name="b" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" Background="#EEF0F3">
        <TextBlock x:Name="t" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tipo}" Value="Copiado"><Setter TargetName="b" Property="Background" Value="#DCFCE7"/><Setter TargetName="t" Property="Foreground" Value="#15803D"/></DataTrigger>
        <DataTrigger Binding="{Binding Tipo}" Value="ACopiar"><Setter TargetName="b" Property="Background" Value="#E0EDFF"/><Setter TargetName="t" Property="Foreground" Value="#1D5FD1"/></DataTrigger>
        <DataTrigger Binding="{Binding Tipo}" Value="AProcessar"><Setter TargetName="b" Property="Background" Value="#EFF5FF"/><Setter TargetName="t" Property="Foreground" Value="#1E7BFF"/></DataTrigger>
        <DataTrigger Binding="{Binding Tipo}" Value="Ajuste"><Setter TargetName="b" Property="Background" Value="#FFEDE3"/><Setter TargetName="t" Property="Foreground" Value="#D9480F"/></DataTrigger>
        <DataTrigger Binding="{Binding Tipo}" Value="Pendente"><Setter TargetName="b" Property="Background" Value="#FDE8E8"/><Setter TargetName="t" Property="Foreground" Value="#C81E1E"/></DataTrigger>
        <DataTrigger Binding="{Binding Tipo}" Value="Erro"><Setter TargetName="b" Property="Background" Value="#C81E1E"/><Setter TargetName="t" Property="Foreground" Value="White"/></DataTrigger>
        <DataTrigger Binding="{Binding Tipo}" Value="Ja"><Setter TargetName="b" Property="Background" Value="#EEF0F3"/><Setter TargetName="t" Property="Foreground" Value="#6B7280"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== Barra lateral ===== -->
    <Border x:Name="Lateral" Width="248" Background="White">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.06" Color="#0F172A"/></Border.Effect>
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="104" Padding="18,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FFE3D3" Offset="0"/>
              <GradientStop Color="#FFF6F1" Offset="0.6"/>
              <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="44" Height="44">
              <Ellipse Fill="{StaticResource Laranja}"/>
              <Path Style="{StaticResource Icone}" Stroke="White" Width="22" Height="22" Data="M7,3 H14 L18,7 V21 H7 Z M14,3 V7 H18 M10,14 L12,16 L16,11.5"/>
            </Grid>
            <StackPanel x:Name="LogoTextos" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="NotaCerta" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
              <TextBlock Text="Duplicidade de NFC-e sem dor" FontSize="10.5" Foreground="{StaticResource TextoSec}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="#F1F2F4" BorderThickness="0,1,0,0">
          <DockPanel>
            <Button x:Name="BtnRecolher" DockPanel.Dock="Right" Width="34" Height="34" Style="{StaticResource BtnPrimario}" Padding="0" ToolTip="Recolher menu">
              <Path x:Name="IconeRecolher" Style="{StaticResource Icone}" Stroke="White" Width="12" Height="12" RenderTransformOrigin="0.5,0.5" Data="M12,5 L6,12 L12,19 M19,5 L13,12 L19,19">
                <Path.RenderTransform><ScaleTransform x:Name="EscalaRecolher" ScaleX="1"/></Path.RenderTransform>
              </Path>
            </Button>
            <TextBlock x:Name="TxtVersao" Text="v1.0" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="11"/>
          </DockPanel>
        </Border>

        <StackPanel Margin="14,8,14,0">
          <Grid x:Name="CaixaPesquisaGrid" Margin="0,0,0,16" Height="40">
            <Border CornerRadius="8" BorderBrush="{StaticResource Borda}" BorderThickness="1" Background="White"/>
            <Path Style="{StaticResource Icone}" Stroke="#6B7280" Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0" Data="M10.5,4 A6.5,6.5 0 1 1 10.49,4 M15.5,15.5 L20,20"/>
            <TextBox x:Name="CaixaPesquisa" Margin="34,0,8,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="DicaPesquisa" Text="Pesquisar nota, pedido, chave..." Margin="36,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" IsHitTestVisible="False"/>
          </Grid>

          <RadioButton x:Name="MenuDuplicidades" Style="{StaticResource Menu}" IsChecked="True">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icone}" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M8,3 H16 L20,7 V17 H8 Z M4,7 V21 H16 V17"/>
              <TextBlock x:Name="Rot1" Text="Duplicidades" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="MenuHistorico" Style="{StaticResource Menu}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icone}" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L15.5,14"/>
              <TextBlock x:Name="Rot2" Text="Histórico" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="MenuRelatorios" Style="{StaticResource Menu}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icone}" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M4,20 H20 M7,16 V11 M12,16 V6 M17,16 V9"/>
              <TextBlock x:Name="Rot3" Text="Relatórios" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="MenuConfig" Style="{StaticResource Menu}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icone}" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M4,7 H20 M4,17 H20 M9,4 V10 M15,14 V20"/>
              <TextBlock x:Name="Rot4" Text="Configurações" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Conteúdo ===== -->
    <Grid Grid.Column="1" Margin="24,18,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Topo: breadcrumb, pílulas e selo do certificado -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="20" FontWeight="SemiBold">
            <Run x:Name="TxtBreadA" Text="Duplicidade" Foreground="#4B5563"/><Run Text=" / " Foreground="#9CA3AF"/><Run x:Name="TxtBreadB" Text="Processamento" Foreground="#FF5A1F"/>
          </TextBlock>
          <Grid x:Name="PainelPilulas" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Border Style="{StaticResource CardFundo}" CornerRadius="22"/>
            <StackPanel Orientation="Horizontal" Margin="5">
              <RadioButton x:Name="PilTodas" Style="{StaticResource Pilula}" IsChecked="True" Content="Todas"/>
              <RadioButton x:Name="PilAProcessar" Style="{StaticResource Pilula}" Content="A processar"/>
              <RadioButton x:Name="PilCopiadas" Style="{StaticResource Pilula}" Content="Copiadas"/>
              <RadioButton x:Name="PilAjuste" Style="{StaticResource Pilula}" Content="Ajuste de chave"/>
              <RadioButton x:Name="PilPendentes" Style="{StaticResource Pilula}" Content="Pendentes"/>
              <RadioButton x:Name="PilJa" Style="{StaticResource Pilula}" Content="Já processadas"/>
            </StackPanel>
          </Grid>
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Top" x:Name="SeloCert">
          <Border Style="{StaticResource CardFundo}" CornerRadius="10"/>
          <StackPanel Orientation="Horizontal" Margin="14,10,18,10">
            <Grid Width="36" Height="36">
              <Ellipse x:Name="SeloFundo" Fill="#FFF1EA"/>
              <Path x:Name="SeloIcone" Style="{StaticResource Icone}" Stroke="#FF5A1F" Width="20" Height="20" Data="M3,5 H21 V16 H3 Z M6,9 H13 M6,12 H11 M17,11 A2.2,2.2 0 1 1 16.99,11 M15.8,13 L15,19 L17,18 L19,19 L18.2,13"/>
            </Grid>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Certificado Digital" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock x:Name="TxtSelo" Text="lendo certificado..." FontSize="11.5" Foreground="{StaticResource TextoSec}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ===== Página: Duplicidades ===== -->
      <Grid x:Name="PagDuplicidades" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de ações -->
        <Grid Margin="0,0,0,16">
          <Border Style="{StaticResource CardFundo}"/>
          <Border Style="{StaticResource CardLinha}"/>
          <Grid Margin="18,16,18,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,6">
                <TextBlock Text="De" VerticalAlignment="Center" Foreground="{StaticResource TextoSec}" Margin="0,0,8,0"/>
                <DatePicker x:Name="DataDe" Width="130" VerticalContentAlignment="Center" Height="34"/>
                <TextBlock Text="até" VerticalAlignment="Center" Foreground="{StaticResource TextoSec}" Margin="12,0,8,0"/>
                <DatePicker x:Name="DataAte" Width="130" VerticalContentAlignment="Center" Height="34"/>
                <Button x:Name="BtnListar" Style="{StaticResource BtnAzul}" Content="Listar notas com 539" Margin="14,0,0,0"/>
                <Button x:Name="BtnProcessar" Style="{StaticResource BtnPrimario}" Content="Processar marcadas" Margin="10,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <Button x:Name="BtnAbrirPasta" Style="{StaticResource BtnSecundario}" Content="Abrir pasta Duplicidade"/>
                <Button x:Name="BtnExportar" Style="{StaticResource BtnSecundario}" Content="Exportar relatório (CSV)" Margin="8,0,0,0"/>
                <Button x:Name="BtnVerLog" Style="{StaticResource BtnSecundario}" Content="Ver log" Margin="8,0,0,0"/>
              </StackPanel>
            </WrapPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ProgressBar x:Name="Progresso" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
              <TextBlock x:Name="TxtStatus" Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource TextoSec}" FontSize="12" TextTrimming="CharacterEllipsis" Text="Pronto."/>
            </Grid>
          </Grid>
        </Grid>

        <!-- Cards de resumo -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Border Style="{StaticResource CardFundo}"/>
            <Border Style="{StaticResource CardLinha}"/>
            <Grid Margin="18,16">
              <StackPanel>
                <TextBlock Style="{StaticResource TituloCard}" Text="DUPLICIDADES ENCONTRADAS"/>
                <TextBlock x:Name="NumEncontradas" Style="{StaticResource NumeroGrande}" Text="0"/>
                <TextBlock x:Name="SubEncontradas" Text="no período" FontSize="11.5" Foreground="{StaticResource TextoSec}"/>
              </StackPanel>
              <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Fill="#EFF5FF"/>
                <Path Style="{StaticResource Icone}" Stroke="#1E7BFF" Width="20" Height="20" Data="M8,3 H16 L20,7 V17 H8 Z M4,7 V21 H16 V17"/>
              </Grid>
            </Grid>
          </Grid>
          <Grid Grid.Column="2">
            <Border Style="{StaticResource CardFundo}"/>
            <Border Style="{StaticResource CardLinha}"/>
            <Grid Margin="18,16">
              <StackPanel>
                <TextBlock Style="{StaticResource TituloCard}" Text="COPIADAS"/>
                <TextBlock x:Name="NumCopiadas" Style="{StaticResource NumeroGrande}" Text="0"/>
                <TextBlock x:Name="SubCopiadas" Text="nesta sessão e anteriores" FontSize="11.5" Foreground="{StaticResource TextoSec}"/>
              </StackPanel>
              <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Fill="#DCFCE7"/>
                <Path Style="{StaticResource Icone}" Stroke="#16A34A" Width="20" Height="20" Data="M12,3 A9,9 0 1 1 11.99,3 M8,12 L11,15 L16,9"/>
              </Grid>
            </Grid>
          </Grid>
          <Grid Grid.Column="4">
            <Border Style="{StaticResource CardFundo}"/>
            <Border Style="{StaticResource CardLinha}"/>
            <Grid Margin="18,16">
              <StackPanel>
                <TextBlock Style="{StaticResource TituloCard}" Text="AJUSTE DE CHAVE"/>
                <TextBlock x:Name="NumAjuste" Style="{StaticResource NumeroGrande}" Text="0"/>
                <TextBlock Text="mesmo valor: ajustar no banco" FontSize="11.5" Foreground="{StaticResource TextoSec}"/>
              </StackPanel>
              <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Fill="#FFEDE3"/>
                <Path Style="{StaticResource Icone}" Stroke="#FF5A1F" Width="20" Height="20" Data="M8,16 A4,4 0 1 1 7.99,16 M10.8,13.2 L20,4 M17,7 L19.5,9.5 M14.5,9.5 L16.5,11.5"/>
              </Grid>
            </Grid>
          </Grid>
          <Grid Grid.Column="6">
            <Border Style="{StaticResource CardFundo}"/>
            <Border Style="{StaticResource CardLinha}"/>
            <Grid Margin="18,16">
              <StackPanel>
                <TextBlock Style="{StaticResource TituloCard}" Text="PENDENTES"/>
                <TextBlock x:Name="NumPendentes" Style="{StaticResource NumeroGrande}" Text="0"/>
                <TextBlock Text="exigem conferência manual" FontSize="11.5" Foreground="{StaticResource TextoSec}"/>
              </StackPanel>
              <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Fill="#FDE8E8"/>
                <Path Style="{StaticResource Icone}" Stroke="#DC2626" Width="20" Height="20" Data="M12,3 L22,20 H2 Z M12,9 V14 M12,17 V17.2"/>
              </Grid>
            </Grid>
          </Grid>
        </Grid>

        <!-- Grade + detalhes -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition x:Name="ColDetalhes" Width="360"/>
          </Grid.ColumnDefinitions>
          <Grid>
            <Border Style="{StaticResource CardFundo}"/>
            <Border Style="{StaticResource CardLinha}"/>
            <DockPanel Margin="18,16,18,12">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnMarcar" Style="{StaticResource BtnLink}" Content="Marcar a processar"/>
                  <TextBlock Text="  ·  " Foreground="#9CA3AF"/>
                  <Button x:Name="BtnDesmarcar" Style="{StaticResource BtnLink}" Content="Desmarcar todas"/>
                </StackPanel>
                <TextBlock Style="{StaticResource TituloCard}" Text="NOTAS COM REJEIÇÃO 539" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid>
                <DataGrid x:Name="Grade" HorizontalScrollBarVisibility="Auto">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" MinWidth="36" CanUserResize="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Marcada, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PodeMarcar}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="NOTA" Binding="{Binding Nota}" Width="86" MinWidth="86" IsReadOnly="True" ElementStyle="{StaticResource TextoForte}"/>
                    <DataGridTextColumn Header="PEDIDO" Binding="{Binding Pedido}" Width="66" MinWidth="66" IsReadOnly="True"/>
                    <DataGridTextColumn Header="EMISSÃO" Binding="{Binding Data}" Width="114" MinWidth="114" IsReadOnly="True"/>
                    <DataGridTextColumn Header="VALOR SIST." Binding="{Binding ValorSistema}" Width="86" MinWidth="86" IsReadOnly="True" ElementStyle="{StaticResource TextoDireita}"/>
                    <DataGridTextColumn Header="VALOR SEFAZ" Binding="{Binding ValorSefaz}" Width="88" MinWidth="88" IsReadOnly="True" ElementStyle="{StaticResource TextoDireita}"/>
                    <DataGridTextColumn Header="ARQUIVO" Binding="{Binding Arquivo}" Width="*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource TextoCortado}"/>
                    <DataGridTemplateColumn Header="STATUS" Width="150" MinWidth="150" CellTemplate="{StaticResource Etiqueta}" SortMemberPath="Status"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="GradeVazia" Text="Nenhuma nota com rejeição 539 no período." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" Visibility="Collapsed"/>
              </Grid>
            </DockPanel>
          </Grid>

          <!-- Detalhes -->
          <Grid Grid.Column="2">
            <Border Style="{StaticResource CardFundo}"/>
            <Border Style="{StaticResource CardLinha}"/>
            <DockPanel Margin="18,16,6,12">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloCard}" Text="DETALHES DA NOTA"/>
              <Grid>
                <TextBlock x:Name="DetVazio" Text="Selecione uma nota na grade." Foreground="#9CA3AF" Margin="0,14,0,0"/>
                <ScrollViewer x:Name="DetPainel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,12,0">
                  <StackPanel>
                    <DockPanel Margin="0,12,0,0">
                      <ContentControl x:Name="DetEtiqueta" DockPanel.Dock="Right" ContentTemplate="{StaticResource Etiqueta}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="DetNota" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    </DockPanel>
                    <TextBlock x:Name="DetPedido" Foreground="{StaticResource TextoSec}" FontSize="12"/>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Rotulo}" Text="Valor do sistema" Margin="0,0,0,2"/>
                        <TextBlock x:Name="DetValorSistema" FontSize="17" FontWeight="SemiBold"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Rotulo}" Text="Valor SEFAZ" Margin="0,0,0,2"/>
                        <TextBlock x:Name="DetValorSefaz" FontSize="17" FontWeight="SemiBold" Foreground="#1E7BFF"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Chave do sistema (rejeitada)"/>
                    <TextBox x:Name="DetChaveSistema" Style="{StaticResource CampoChave}"/>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Chave autorizada (retorno 539)"/>
                    <TextBox x:Name="DetChaveAut" Style="{StaticResource CampoChave}" Foreground="#1D5FD1"/>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Situação na SEFAZ"/>
                    <TextBlock x:Name="DetSefaz" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Protocolo / digVal"/>
                    <TextBox x:Name="DetProt" Style="{StaticResource CampoChave}"/>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Arquivo escolhido"/>
                    <TextBox x:Name="DetArquivo" Style="{StaticResource CampoChave}" FontFamily="Segoe UI"/>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Motivo"/>
                    <TextBlock x:Name="DetMotivo" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Candidatos (arquivos com a chave autorizada)" Margin="0,14,0,6"/>
                    <ItemsControl x:Name="DetCandidatos">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="c" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Background="#F9FAFB" BorderBrush="#EEF0F3" BorderThickness="1">
                            <DockPanel>
                              <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,8,0">
                                <Ellipse x:Name="e" Fill="#FDE8E8"/>
                                <TextBlock x:Name="s" Text="✕" FontSize="11" FontWeight="Bold" Foreground="#C81E1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Grid>
                              <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Pasta}" FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Motivo}" FontSize="11.5" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,3,0,0"/>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Aceito}" Value="True">
                              <Setter TargetName="e" Property="Fill" Value="#DCFCE7"/>
                              <Setter TargetName="s" Property="Text" Value="✓"/>
                              <Setter TargetName="s" Property="Foreground" Value="#15803D"/>
                              <Setter TargetName="c" Property="Background" Value="#F3FBF6"/>
                              <Setter TargetName="c" Property="BorderBrush" Value="#BBEBCD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Avaliado}" Value="False">
                              <Setter TargetName="e" Property="Fill" Value="#EEF0F3"/>
                              <Setter TargetName="s" Property="Text" Value="?"/>
                              <Setter TargetName="s" Property="Foreground" Value="#6B7280"/>
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Rotulo}" Text="Origem da duplicidade"/>
                    <TextBlock x:Name="DetOrigem" TextWrapping="Wrap" FontSize="11.5" Foreground="#4B5563" Margin="0,0,0,8"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </DockPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- ===== Página: Histórico ===== -->
      <Grid x:Name="PagHistorico" Grid.Row="1" Visibility="Collapsed">
        <Border Style="{StaticResource CardFundo}"/>
        <Border Style="{StaticResource CardLinha}"/>
        <DockPanel Margin="18,16,18,12">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="BtnAtualizarHist" DockPanel.Dock="Right" Style="{StaticResource BtnSecundario}" Content="Atualizar"/>
            <StackPanel>
              <TextBlock Style="{StaticResource TituloCard}" Text="HISTÓRICO DE CÓPIAS"/>
              <TextBlock x:Name="TxtHistCaminho" FontSize="11.5" Foreground="{StaticResource TextoSec}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="GradeHistorico">
            <DataGrid.Columns>
              <DataGridTextColumn Header="DATA/HORA" Binding="{Binding DataHora}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="SÉRIE/NÚMERO" Binding="{Binding Nota}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource TextoForte}"/>
              <DataGridTextColumn Header="CHAVE AUTORIZADA" Binding="{Binding ChaveAutorizada}" Width="330" IsReadOnly="True"/>
              <DataGridTextColumn Header="ARQUIVO" Binding="{Binding Arquivo}" Width="220" IsReadOnly="True" ElementStyle="{StaticResource TextoCortado}"/>
              <DataGridTextColumn Header="DESTINO" Binding="{Binding CaminhoDestino}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource TextoCortado}"/>
              <DataGridTemplateColumn Header="STATUS" Width="130" CellTemplate="{StaticResource Etiqueta}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>

      <!-- ===== Página: Relatórios ===== -->
      <Grid x:Name="PagRelatorios" Grid.Row="1" Visibility="Collapsed">
        <Border Style="{StaticResource CardFundo}"/>
        <Border Style="{StaticResource CardLinha}"/>
        <DockPanel Margin="18,16,18,12">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnAbrirRel" Style="{StaticResource BtnPrimario}" Content="Abrir selecionado"/>
              <Button x:Name="BtnPastaRel" Style="{StaticResource BtnSecundario}" Content="Abrir pasta" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource TituloCard}" Text="RELATÓRIOS E LOGS"/>
              <TextBlock x:Name="TxtRelCaminho" FontSize="11.5" Foreground="{StaticResource TextoSec}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="GradeRelatorios">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ARQUIVO" Binding="{Binding Nome}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource TextoForte}"/>
              <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="120" IsReadOnly="True"/>
              <DataGridTextColumn Header="GERADO EM" Binding="{Binding Data}" Width="160" IsReadOnly="True"/>
              <DataGridTextColumn Header="TAMANHO" Binding="{Binding Tamanho}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource TextoDireita}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>

      <!-- ===== Página: Configurações ===== -->
      <Grid x:Name="PagConfig" Grid.Row="1" Visibility="Collapsed">
        <Border Style="{StaticResource CardFundo}"/>
        <Border Style="{StaticResource CardLinha}"/>
        <DockPanel Margin="18,16,18,12">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnEditarIni" Style="{StaticResource BtnSecundario}" Content="Editar duplicidade.ini"/>
              <Button x:Name="BtnRecarregar" Style="{StaticResource BtnPrimario}" Content="Recarregar" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource TituloCard}" Text="CONFIGURAÇÕES EM USO"/>
              <TextBlock Text="A senha do certificado nunca é exibida; aparece só de onde ela foi lida." FontSize="11.5" Foreground="{StaticResource TextoSec}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaConfig">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1"/>
                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextoSec}" Margin="0,11"/>
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
